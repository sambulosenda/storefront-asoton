SHOPIFY_STORE_DOMAIN=iwsv0v-te.myshopify.com
# Public Storefront access token from the Headless sales channel in Shopify admin (see README). Never commit it.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10

# Leave these unset to use Shopify's public demo store (mock.shop).
# Create a Storefront access token in Shopify admin: Settings > Apps and sales channels > Develop apps.
# Set to your-store.myshopify.com to use a real store.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10

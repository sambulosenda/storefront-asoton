# Our Shopify store (My Store 2). Leave SHOPIFY_STORE_DOMAIN empty to use Shopify's demo store (mock.shop) instead.
SHOPIFY_STORE_DOMAIN=iwsv0v-te.myshopify.com
# Public Storefront access token from the Headless sales channel in Shopify admin (see README). Never commit it.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10
# The site's public address, used for canonical links, the sitemap and share images. Vercel sets its own when this is empty.
SITE_URL=
# Emails to the shop from the contact form, back-in-stock requests and newsletter fallbacks, sent with Resend (resend.com).
# Leave empty and those forms say plainly that they aren't connected yet.
RESEND_API_KEY=
# The inbox that receives them. Without a verified domain in Resend, this must be the email the Resend account was made with.
SHOP_EMAIL=
# Optional, once a domain is verified in Resend, e.g. AsoTone <hello@asotone.com>.
MAIL_FROM=

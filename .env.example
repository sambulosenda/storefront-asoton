# Our Shopify store (My Store 2). Leave SHOPIFY_STORE_DOMAIN empty to use Shopify's demo store (mock.shop) instead.
SHOPIFY_STORE_DOMAIN=iwsv0v-te.myshopify.com
# Public Storefront access token from the Headless sales channel in Shopify admin (see README). Never commit it.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10
# The site's public address, used for canonical links, the sitemap and share images. Vercel sets its own when this is empty.
SITE_URL=
# Emails to the shop from the contact form, back-in-stock requests and newsletter fallbacks, sent with Resend (resend.com).
# Leave empty and those forms say plainly that they aren't connected yet.
RESEND_API_KEY=
# The inbox that receives them. Without a verified domain in Resend, this must be the email the Resend account was made with.
SHOP_EMAIL=
# Optional, once a domain is verified in Resend, e.g. AsoTone <hello@asotone.com>.
MAIL_FROM=
# The shop assistant (the "Ask us" chat), answered by Claude. Make a key at console.anthropic.com > API keys, and set a
# monthly spend limit there too. Leave empty and the chat button doesn't show. Never commit the key.
ANTHROPIC_API_KEY=
# The shop assistant on WhatsApp (see README > Shop assistant > On WhatsApp). From the Meta app's WhatsApp > API Setup:
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > App settings > Basic > App secret. Proves messages to /api/whatsapp really come from Meta. Never commit it.
WHATSAPP_APP_SECRET=
# A system user's permanent token in production (the API Setup page's token lasts a day). Never commit it.
WHATSAPP_ACCESS_TOKEN=
# Any long random string you make up; give Meta the same one when setting up the webhook.
WHATSAPP_VERIFY_TOKEN=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX), from GA4 Admin > Data streams > Web. Loads only after a shopper accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# PostHog project token (phc_...), from PostHog > Settings > Project. Records where shoppers get to and where they stop,
# with session recordings, only after a shopper accepts analytics cookies. Leave empty and nothing loads.
NEXT_PUBLIC_POSTHOG_KEY=
# Only if the PostHog project isn't on the EU cloud (the default is https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=
